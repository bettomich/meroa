{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEROA",
  "version": "0.1.0",
  "identifier": "com.meroa.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MEROA",
        "width": 388,
        "height": 620,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": [
      "../legal/FONT_LICENSES.md",
      "../legal/THIRD_PARTY_NOTICES.md",
      "../assets/fonts/SpaceGrotesk-OFL.txt",
      "../assets/fonts/Doto-OFL.txt"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQTJGQTE4MTU0QzgwN0MKUldSOGdFd1ZHUHFpT2tveU5HMGFEdkJ1WE9MK21OUXJmTGhiWlE4YWFHL0NIN1dHR0JjTThjV08K",
      "endpoints": [
        "https://github.com/bettomich/meroa/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
